# v3 is append-only over the released v2 evidence dossier.
schema gooo/incremental-conformance-planner/meta/v3
program gooo-incremental-conformance-planner
namespace gooo.incremental.conformance.planner.v3
precedence REFUTED > UNKNOWN > CLOSED

authority SemanticChangeSet
authority ProofGraph
authority TestIdentity
authority ConformanceIdentity
authority InputDigest
authority ToolchainDigest
authority SemanticIRDigest
authority PriorRunIdentity
authority Observation
authority EvidenceSelection
authority ImprovementPair
authority Dossier

semantic_change_set before_digest after_digest changed_nodes
proof_graph nodes edges edge_digests
test_identity exact
conformance_identity exact
input_digest digest
toolchain_digest digest
semantic_ir_digest digest
prior_run_identity run_id commit_sha receipt_digest
observation build_ms test_ms wall_ms peak_rss_kib cache_hit cache_miss
selection_policy deterministic impact_then_identity_then_provenance
identity_fields test_identity conformance_identity scenario_identity input_digest toolchain_digest semantic_ir_digest source_digest fixture_digest contract_digest evaluator_digest
prior_run_fields run_id commit_sha receipt_digest
observation_fields build_ms test_ms wall_ms peak_rss_kib cache_hit cache_miss
unknown_fields stage step reason unknown_class next_operation blocked_by

policy EXACT_TEST_CONFORMANCE_IDENTITY_ONLY
policy REUSE_ONLY_INDEPENDENT_IMMUTABLE_PASS
policy IMPACT_OR_IDENTITY_CHANGE_REQUIRES_RUN
policy MISSING_METRICS_UNKNOWN_REUSE_AND_MEASUREMENT_CLAIM
policy EXACT_MATCHED_PAIR_ONLY_PER_INDICATOR_DELTA
policy NO_TOTAL_SCORE_OR_WEIGHTED_SCORE_OR_ESTIMATE
policy LEGACY_EXACT_REUSE_MUST_REMAIN_CLOSED
policy FIXED_POINT_ONLY_IF_EXPLICIT
policy UNKNOWN_TOP_DECISION_FAIL_CLOSED
policy MALFORMED_OR_IMPLICIT_FIXED_POINT_REFUTED

unknown_class enum MISSING_IDENTITY MISSING_PROVENANCE MISSING_IMMUTABLE_RECEIPT MISSING_ACTIONS_METRIC MISSING_PRIOR_RUN_IDENTITY
toolchain_digest sha256:go1.27.0
proof_choice FOUNDATION
proof_choice COHERENCE
proof_choice REGRESSION
indicator_class DRIVER
indicator_class OUTCOME
indicator_class GUARDRAIL
fixed_point_rule FIXED_POINT_ONLY_IF_EXPLICIT
fixed_point_rule UNKNOWN_TOP_DECISION_FAIL_CLOSED
fixed_point_rule MALFORMED_OR_IMPLICIT_FIXED_POINT_REFUTED
fixed_point_case exact-reuse EXPLICIT_FIXED_POINT

activity 1 DECLARE_CHANGE_SET DeclareSemanticChangeSet INPUT DECLARE_SEMANTIC_CHANGE_SET FOUNDATION DRIVER -
activity 2 PROJECT_SEMANTIC_IR ProjectSemanticIR PROJECT PROJECT_GOOO_TO_SEMANTIC_IR FOUNDATION DRIVER DECLARE_CHANGE_SET
activity 3 VERIFY_DEPENDENCY_GRAPH VerifyDependencyGraph GRAPH VERIFY_DEPENDENCY_AND_PROOF_GRAPH FOUNDATION OUTCOME PROJECT_SEMANTIC_IR
activity 4 VERIFY_PROOF_GRAPH VerifyProofGraph GRAPH VERIFY_PROOF_GRAPH_DIGESTS FOUNDATION GUARDRAIL VERIFY_DEPENDENCY_GRAPH
activity 5 BIND_SOURCE_IR_FIXTURE BindSourceIRFixtureIdentity BINDING BIND_SOURCE_IR_FIXTURE_IDENTITY COHERENCE DRIVER PROJECT_SEMANTIC_IR
activity 6 BIND_CONTRACT_EVALUATOR BindContractEvaluatorIdentity BINDING BIND_CONTRACT_EVALUATOR_IDENTITY COHERENCE OUTCOME PROJECT_SEMANTIC_IR
activity 7 BIND_TOOLCHAIN_ACTIVITY BindToolchainActivityIdentity BINDING BIND_TOOLCHAIN_AND_ACTIVITY_IDENTITY COHERENCE GUARDRAIL BIND_SOURCE_IR_FIXTURE
activity 8 VERIFY_PRIOR_RECEIPT VerifyPriorImmutableReceipt RECEIPT VERIFY_PRIOR_IMMUTABLE_RECEIPT COHERENCE DRIVER BIND_CONTRACT_EVALUATOR
activity 9 APPLY_IMPACT_REUSE_RULE ApplyImpactReuseRule PLAN APPLY_IMPACT_AND_REUSE_RULE REGRESSION OUTCOME VERIFY_PRIOR_RECEIPT
activity 10 OBSERVE_ACTIONS_RECEIPT ObserveActionsReceipt OBSERVATION OBSERVE_ACTIONS_BUILD_TEST_RECEIPT REGRESSION GUARDRAIL APPLY_IMPACT_REUSE_RULE
activity 11 CLASSIFY_ACTIVITY_DOSSIER ClassifyActivityDossier DOSSIER CLASSIFY_REQUIRED_REUSE_UNKNOWN_REFUTED REGRESSION OUTCOME OBSERVE_ACTIONS_RECEIPT
activity 12 RENDER_HUMAN_DOSSIER RenderHumanCIDossier REPORT RENDER_MACHINE_AND_HUMAN_CI_DOSSIER REGRESSION GUARDRAIL CLASSIFY_ACTIVITY_DOSSIER
